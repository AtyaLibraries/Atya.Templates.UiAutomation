<Project>
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <PackageId>Atya.Templates.UiAutomation</PackageId>
    <Title>Atya UI Automation</Title>
    <Authors>Arsen Asulyan</Authors>
    <Company>Atya</Company>
    <Description>.NET 10 Playwright + xUnit v3 + Microsoft Testing Platform UI-automation solution template. `dotnet new atya-ui-automation`.</Description>
    <PackageProjectUrl>https://github.com/AtyaLibraries/Atya.Templates.UiAutomation</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AtyaLibraries/Atya.Templates.UiAutomation</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <PackageTags>dotnet;template;playwright;xunit;ui-automation;testing;net10</PackageTags>
    <IsPackable>true</IsPackable>

    <!-- Template packages carry NO runtime dependencies (docs/architecture.md Section 31.3). -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS2008;NU5128;NU5110;NU5111;AD0001</NoWarn>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <!-- The central publisher restores this project in locked mode (it is passed as the
         build "solution"), so it needs its own committed lock file. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="**/*"
             Exclude="bin/**;obj/**;artifacts/**;**/bin/**;**/obj/**;**/artifacts/**;TestResults/**;raw-artifacts/**;probe/**;.git;.git/**;.vs;.vs/**;.idea;.idea/**;PACKAGE_README.md;README.md;docs/architecture.md;CHANGELOG.md;Atya.Templates.UiAutomation.csproj;packages.lock.json;template-smoke-test.ps1;.github/workflows/test-template.yml" />
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" VersionOverride="7.0.0" PrivateAssets="all" Condition="Exists('$(MSBuildThisFileDirectory).git')" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
